# Environment Configuration Example for Knowledge Base Hub & RAG Pipeline

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Django Configuration
DEBUG=True
SECRET_KEY=django-insecure-kb-hub-key-task-1-gemini-rag-secret

# Ollama / Local Model Configuration (Optional / Task 2)
OLLAMA_BASE_URL=http://localhost:11434
